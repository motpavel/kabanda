{
  "name": "@kabanda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run test/auth.postgres.test.ts test/kabandas.postgres.test.ts --no-file-parallelism",
    "points:import": "tsx src/import-alpha.ts",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@kabanda/contracts": "workspace:*",
    "@kabanda/domain": "workspace:*",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
