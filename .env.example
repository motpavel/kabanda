NODE_ENV=development
API_BUILD_ID=dev
ALPHA_DIAGNOSTICS_ENABLED=false
VITE_ALPHA_DIAGNOSTICS=false
# Browser key for Yandex Maps JavaScript API v3. Restrict it by HTTP Referer in the Yandex console.
VITE_YANDEX_MAPS_API_KEY=
API_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://localhost:5173
APP_BASE_PATH=/
# Production same-origin stand only; leave unset for split local Vite dev.
# PWA_DIST_DIR=/absolute/path/to/apps/pwa/dist
# TRUST_PROXY_ADDRESS=127.0.0.1
EXPECTED_MIGRATION=0010_kabanda_cover.sql
ALPHA_ACCESS_MODE=disabled
# Required with ALPHA_ACCESS_MODE=enforced; generate a distinct random value of at least 32 characters.
# ALPHA_ACCESS_SECRET=
# Required only when importing a manifest with field_verified points.
# ALPHA_FIELD_EVIDENCE_ROOT=/absolute/restricted/operator-storage
DATABASE_URL=postgresql://kabanda:kabanda@127.0.0.1:54329/kabanda
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=kabanda@example.test
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
MEDIA_CAPABILITY_SECRET=replace-with-at-least-32-random-characters
