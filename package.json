{
  "name": "kabanda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kabanda/pwa --filter @kabanda/api dev",
    "dev:pwa": "pnpm --filter @kabanda/pwa dev",
    "dev:api": "pnpm --filter @kabanda/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:points && pnpm test:stand && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @kabanda/api e2e:run",
    "test:points": "node scripts/validate-alpha-points.mjs",
    "test:stand": "node --test infra/stand/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "pnpm --filter @kabanda/api db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0"
  }
}
